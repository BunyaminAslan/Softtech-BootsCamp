#!/bin/sh
# agent-team pre-commit kontrolü (şablon).
# /agent-team:setup-project bu dosyayı ve review-cache.js'i projenin .githooks/ klasörüne kopyalar
# ve `git config core.hooksPath .githooks` ayarlar.
#
# Commit öncesi agent-team:precommit-lead'i (pre-commit-reviewer + sprint-documenter) çalıştırır.
# Sonuç FAIL ise commit engellenir. Acil durumda atlamak için: git commit --no-verify
# Gereksinim: agent-team plugin'i bu projede etkin olmalı ve `claude` PATH'te olmalı.
#
# Önbellek: Son kontrolden bu yana staged diff'te değişiklik yoksa agent'lar çalışmaz,
# önceki karar kullanılır. Bir kısmı değiştiyse yalnızca değişen hunk'lar incelenir.
#   Önbelleği yok sayıp tam kontrol:   PRECOMMIT_FORCE=1 git commit ...
#   Önbelleği sıfırlamak:              node .githooks/review-cache.js reset
#   Agent adı farklıysa (override):    AGENT_TEAM_PRECOMMIT_AGENT=<ad> git commit ...

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

# Staged değişiklik yoksa yapılacak bir şey yok
if git diff --cached --quiet; then
  exit 0
fi

N=$(( $(git rev-list --count HEAD 2>/dev/null || echo 0) + 1 ))
DOC="Docs/Sprint_$N.md"
CACHE_JS="$ROOT/.githooks/review-cache.js"
PRECOMMIT_AGENT="${AGENT_TEAM_PRECOMMIT_AGENT:-agent-team:precommit-lead}"

# --- Önbellek kontrolü ---------------------------------------------------------
STATUS=""
if command -v node >/dev/null 2>&1 && [ -f "$CACHE_JS" ]; then
  CHECK_OUT=$(node "$CACHE_JS" check --scope staged 2>&1)
  if [ $? -eq 0 ]; then
    STATUS=$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^STATUS: //p')
    PREV=$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^PREV_VERDICT_CODE: //p')
    PREV_LINE=$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^PREV_VERDICT: //p')
    PREV_AT=$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^PREV_CHECKED_AT: //p')
  else
    echo "⚠️  Önbellek kontrolü hata verdi, tam kontrol yapılacak:"
    printf '%s\n' "$CHECK_OUT"
  fi
else
  echo "⚠️  node veya .githooks/review-cache.js bulunamadı, önbelleksiz tam kontrol yapılacak."
fi

if [ "$STATUS" = "UNCHANGED" ]; then
  echo "♻️  Son kontrolden ($PREV_AT) bu yana staged diff değişmedi; agent'lar tekrar çalıştırılmadı."
  echo "   Önceki karar: $PREV_LINE"
  if [ "$PREV" = "FAIL" ]; then
    echo ""
    echo "❌ Önceki kontrol commit'i engellemişti ve o zamandan beri bir şey değişmedi, commit engellendi."
    echo "   Rapor: .precommit-cache/last-report.md"
    echo "   Bulguları düzeltip tekrar deneyin ya da tam kontrol için: PRECOMMIT_FORCE=1 git commit ..."
    exit 1
  fi
  [ -f "$DOC" ] && git add "$DOC"
  echo "✅ Önceki kontrol geçerli, commit devam ediyor."
  exit 0
fi

# --- Agent akışı (FULL veya PARTIAL) ---------------------------------------------
# Claude CLI: önce PATH, yoksa VS Code eklentisindeki en yeni sürüm
CLAUDE_BIN=$(command -v claude)
if [ -z "$CLAUDE_BIN" ]; then
  CLAUDE_BIN=$(ls -d "$HOME"/.vscode/extensions/anthropic.claude-code-*/resources/native-binary/claude.exe 2>/dev/null | sort -V | tail -n 1)
fi
if [ -z "$CLAUDE_BIN" ]; then
  echo "❌ Claude CLI bulunamadı, commit engellendi."
  echo "   Kurulum: https://code.claude.com/docs (claude PATH'te olmalı)"
  exit 1
fi

LOG_DIR="$(git rev-parse --git-dir)/precommit-lead"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/last-run.log"

if [ "$STATUS" = "PARTIAL" ]; then
  echo "🔍 Son kontrolden sonra bazı değişiklikler farklılaşmış; yalnızca bunlar incelenecek:"
  printf '%s\n' "$CHECK_OUT" | sed -n '/^CHANGED_FILES:/,$p'
else
  echo "🔍 $PRECOMMIT_AGENT commit öncesi tam kontrolü çalıştırıyor (birkaç dakika sürebilir)..."
fi

"$CLAUDE_BIN" -p --agent "$PRECOMMIT_AGENT" --permission-mode acceptEdits \
  "HOOK MODU: Staged değişiklikler için commit öncesi akışı çalıştır (pre-commit-reviewer ardından sprint-documenter). Kapsam: staged. Önce önbellek kontrolünü (node .githooks/review-cache.js check --scope staged) çalıştır ve sonucuna göre tam ya da kısmi akış uygula." \
  < /dev/null 2>&1 | tee "$LOG"

VERDICT=$(grep -o 'LEAD_VERDICT: [A-Z]*' "$LOG" | tail -n 1)

if [ "$VERDICT" = "LEAD_VERDICT: PASS" ]; then
  # Sprint dokümanını bu commit'e dahil et
  [ -f "$DOC" ] && git add "$DOC"
  echo "✅ Pre-commit kontrolü geçti, commit devam ediyor."
  exit 0
fi

echo ""
echo "❌ Pre-commit kontrolü başarısız, commit engellendi."
echo "   Detaylar: $LOG"
if grep -q "agent.*not found\|Unknown agent\|bulunamadı" "$LOG" 2>/dev/null; then
  echo "   İpucu: agent-team plugin'i bu projede etkin mi? (claude plugin list)"
fi
exit 1
