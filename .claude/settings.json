{
  "agent": "precommit-lead",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-list *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git config user.name)",
      "Bash(date *)",
      "Bash(mkdir *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet list package *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)",
      "Bash(npm audit *)",
      "Bash(npx jest *)",
      "Bash(npx vitest *)",
      "Bash(mvn test *)",
      "Bash(gradle test *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-stop.js\""
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-stop.js\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/task-completed.js\""
          }
        ]
      }
    ]
  }
}
