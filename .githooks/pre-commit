#!/bin/sh
# Framework reposunun kendi pre-commit kontrolü (ürün repolarına kurulan hook bu değil:
# o, plugin/templates/githooks/pre-commit şablonudur).
# Deterministik ve hızlıdır: hook testleri + (claude varsa) plugin/marketplace doğrulaması.
# Atlamak için (acil durum): git commit --no-verify

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "❌ node bulunamadı; framework testleri çalıştırılamadı." >&2
  exit 1
fi

echo "🧪 agent-team framework testleri..."
if ! node --test tests/hooks/*.test.js > .git/agent-team-tests.log 2>&1; then
  grep -E "^(not ok|✖)" .git/agent-team-tests.log | head -20
  echo "❌ Testler başarısız, commit engellendi. Ayrıntı: .git/agent-team-tests.log" >&2
  exit 1
fi
grep -E "^ℹ (tests|pass|fail)" .git/agent-team-tests.log

if command -v claude >/dev/null 2>&1; then
  echo "🔎 claude plugin validate..."
  if ! claude plugin validate ./plugin >/dev/null 2>&1; then
    claude plugin validate ./plugin
    echo "❌ Plugin doğrulaması başarısız, commit engellendi." >&2
    exit 1
  fi
  if ! claude plugin validate . >/dev/null 2>&1; then
    claude plugin validate .
    echo "❌ Marketplace doğrulaması başarısız, commit engellendi." >&2
    exit 1
  fi
  echo "✔ plugin ve marketplace geçerli"
else
  echo "⚠️  claude bulunamadı; plugin doğrulaması atlandı."
fi
exit 0
